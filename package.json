{
  "name": "chauffit-main",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --watchAll=false",
    "test:integration": "jest --testPathPattern=integration",
    "test:customer": "jest --testPathPattern=customer",
    "test:driver": "jest --testPathPattern=driver",
    "test:biker": "jest --testPathPattern=biker",
    "test:shared": "jest --testPathPattern=shared",
    "test:emergency": "jest --testPathPattern=EmergencyButton",
    "test:payments": "jest --testPathPattern=payment",
    "test:performance": "jest --testPathPattern=performance",
    "test:security": "jest --testPathPattern=security",
    "test:a11y": "jest --testPathPattern=accessibility",
    "test:e2e": "detox test",
    "test:e2e:android": "detox test --configuration android",
    "test:e2e:ios": "detox test --configuration ios",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "analyze:bundle": "expo export && npx @next/bundle-analyzer build",
    "a11y:report": "axe-cli --reporter html --output-dir a11y-report"
  },
  "dependencies": {
    "expo": "~53.0.22",
    "expo-constants": "~17.1.7",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.1",
    "expo-router": "~5.1.5",
    "expo-status-bar": "~2.2.3",
    "@expo/vector-icons": "^14.0.4",
    "react-native-maps": "^1.17.3",
    "expo-sms": "~13.1.2",
    "nativewind": "^4.1.23",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.8",
    "@supabase/supabase-js": "^2.45.4",
    "@stripe/stripe-react-native": "^0.38.6",
    "expo-contacts": "~13.1.1",
    "expo-haptics": "~13.1.2",
    "expo-secure-store": "~13.1.0",
    "expo-av": "~14.1.7",
    "expo-notifications": "~0.30.8",
    "react-native-onesignal": "^5.2.6",
    "react-native-google-places-autocomplete": "^2.5.6",
    "react-native-geocoding": "^0.5.0",
    "react-native-maps-directions": "^1.9.0",
    "@react-native-async-storage/async-storage": "1.27.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-network-state": "^1.1.3",
    "expo-network": "~6.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3",
    "jest": "^29.7.0",
    "@jest/types": "^29.6.3",
    "jest-environment-jsdom": "^29.7.0",
    "react-test-renderer": "^18.2.0",
    "@testing-library/react-native": "^12.4.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "jest-expo": "^51.0.4",
    "ts-jest": "^29.1.2",
    "@types/react-test-renderer": "^18.0.7",
    "jest-fetch-mock": "^3.0.3",
    "msw": "^2.0.11",
    "@faker-js/faker": "^8.4.1",
    "detox": "^20.18.3",
    "@react-native-community/eslint-config": "^3.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "private": true
}
