# Chauffit Platform Environment Variables
# Copy this file to .env and fill in your actual values

# ================================
# APP CONFIGURATION
# ================================
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# ================================
# GOOGLE SERVICES
# ================================
# Get these from Google Cloud Console
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ================================
# SUPABASE CONFIGURATION
# ================================
# Get these from your Supabase project dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ================================
# STRIPE PAYMENT CONFIGURATION
# ================================
# Get these from your Stripe dashboard
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ================================
# ONESIGNAL PUSH NOTIFICATIONS
# ================================
# Get these from OneSignal dashboard
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_API_KEY=your_onesignal_api_key_here

# ================================
# API CONFIGURATION
# ================================
# Your backend API endpoints
EXPO_PUBLIC_API_BASE_URL=https://api.chauffit.com
# For development, use: http://localhost:3000
# For staging, use: https://staging-api.chauffit.com

# ================================
# FEATURE FLAGS
# ================================
# Enable/disable features (true/false)
EXPO_PUBLIC_REAL_TIME_TRACKING=true
EXPO_PUBLIC_BIOMETRIC_AUTH=true
EXPO_PUBLIC_VOICE_CALLING=true
EXPO_PUBLIC_CHAT_MESSAGING=true
EXPO_PUBLIC_EMERGENCY_ALERTS=true
EXPO_PUBLIC_SCHEDULED_BOOKINGS=true
EXPO_PUBLIC_MULTIPLE_PAYMENTS=true
EXPO_PUBLIC_LOYALTY_PROGRAM=false

# Document Verification Configuration
# Set to true to enable Signzy-powered Aadhaar OTP verification
# When false, admin manually reviews uploaded Aadhaar photos
EXPO_PUBLIC_AADHAAR_OTP_ENABLED=false

# ================================
# INDIAN MARKET CONFIGURATION
# ================================
EXPO_PUBLIC_UPI_ENABLED=true
EXPO_PUBLIC_GST_ENABLED=true
EXPO_PUBLIC_INDIAN_PHONE_VALIDATION=true

# ================================
# DEVELOPMENT/DEBUG SETTINGS
# ================================
# Only for development - set to false in production
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_SHOW_PERFORMANCE_MONITOR=false

# ================================
# SECURITY CONFIGURATION
# ================================
# JWT secrets (generate secure random strings)
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Database encryption key
DB_ENCRYPTION_KEY=your_db_encryption_key_here

# ================================
# THIRD PARTY INTEGRATIONS
# ================================
# Twilio for SMS (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS S3 for file uploads (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1

# Firebase for additional analytics (optional)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ================================
# MONITORING & ANALYTICS
# ================================
# Sentry for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=your_ga_id_here

# ================================
# PAYMENT GATEWAY SPECIFIC
# ================================
# Razorpay (Indian payment gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# PayU (Alternative Indian gateway)
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt

# ================================
# SOCIAL MEDIA INTEGRATION
# ================================
# Facebook App ID (for social login)
FACEBOOK_APP_ID=your_facebook_app_id

# Google OAuth (for social login)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id

# ================================
# EMAIL SERVICE
# ================================
# SendGrid for transactional emails
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@chauffit.com

# ================================
# RATE LIMITING & CACHING
# ================================
# Redis for caching and sessions (optional)
REDIS_URL=redis://localhost:6379

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# ENVIRONMENT SPECIFIC OVERRIDES
# ================================
# These will override the base configuration based on APP_ENV

# Development overrides
DEV_API_BASE_URL=http://localhost:3000
DEV_SUPABASE_URL=https://your-dev-project.supabase.co
DEV_STRIPE_PUBLISHABLE_KEY=pk_test_dev_key_here

# Staging overrides
STAGING_API_BASE_URL=https://staging-api.chauffit.com
STAGING_SUPABASE_URL=https://your-staging-project.supabase.co
STAGING_STRIPE_PUBLISHABLE_KEY=pk_test_staging_key_here

# Production overrides
PROD_API_BASE_URL=https://api.chauffit.com
PROD_SUPABASE_URL=https://your-prod-project.supabase.co
PROD_STRIPE_PUBLISHABLE_KEY=pk_live_prod_key_here

# ================================
# ADDITIONAL NOTES
# ================================
# 1. Never commit the actual .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use different keys for development, staging, and production
# 4. Test all integrations in staging before deploying to production
# 5. Monitor your API usage and billing for all third-party services
# 6. Set up proper error alerting and monitoring
# 7. Ensure compliance with Indian payment regulations (PCI DSS)
# 8. Configure proper CORS and security headers for your API
# 9. Use HTTPS for all API endpoints
# 10. Implement proper logging and audit trails

# ================================
# GETTING STARTED CHECKLIST
# ================================
# □ 1. Copy this file to .env
# □ 2. Set up Google Cloud Console project and enable Maps/Places APIs
# □ 3. Create Supabase project and get credentials
# □ 4. Set up Stripe account and get API keys
# □ 5. Create OneSignal app for push notifications
# □ 6. Configure your backend API endpoints
# □ 7. Test all integrations in development
# □ 8. Set up staging environment
# □ 9. Configure production environment with live keys
# □ 10. Set up monitoring and error tracking